<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<BorderPane prefHeight="503.0" prefWidth="762.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.retopsp.cliente.controlador.ChatController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="10.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         <children>
            <Label text="IP:" />
            <TextField fx:id="ip" prefWidth="110.0" promptText="127.0.0.1" HBox.hgrow="SOMETIMES" />
            <Label text="Puerto:" />
            <TextField fx:id="puerto" prefWidth="60.0" promptText="5000" />
            <Label text="Usuario:" />
            <TextField fx:id="user" prefWidth="110.0" promptText="Duxon" HBox.hgrow="SOMETIMES" />
            <Button fx:id="conectar" mnemonicParsing="false" onAction="#conectar" text="Conectar" />
            <Button fx:id="desconectar" disable="true" mnemonicParsing="false" text="Desconectar" onAction= "#desconectar" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="estado" text="No conectado" />
         </children>
      </HBox>
   </top>
   <bottom>
      <HBox fx:id="p" alignment="CENTER_LEFT" spacing="10.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         <children>
            <CheckBox fx:id="privado" mnemonicParsing="false" text="Privado" />
            <Label text="Para:" />
            <TextField fx:id="receptor" prefWidth="100.0" promptText="admin" />
            <TextField fx:id="mensage" HBox.hgrow="ALWAYS" />
            <Button fx:id="enviar" mnemonicParsing="false" onAction="#enviarMensaje" prefWidth="70.0" text="Enviar" />
         </children>
      </HBox>
   </bottom>
   <center>
      <ListView fx:id="chat" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER" />
   </center>
</BorderPane>
